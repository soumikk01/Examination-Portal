generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id             Int      @id @default(autoincrement())
  collegeId      String   @unique(map: "sqlite_autoindex_Students_1") @map("collegeId")
  name           String
  degree         String?
  department     String?
  studentRoll    String?  @unique @map("studentRoll")
  studentReg     String?  @map("studentReg")
  examinationSem String?  @map("examinationSem")
  batch          String?
  sessionId      String?
  lastLogin      DateTime?

  // New fields used for exam visibility and filtering
  program        Program?
  branch         String?
  semester       String?

  exams          Exam[]

  @@map("Students")
}

model Exam {
  id           Int          @id @default(autoincrement())
  examId       String
  subject      String
  date         DateTime?
  time         String?
  room         String?
  examType     ExamType
  examMode     ExamMode
  examCategory ExamCategory
  program      Program
  branch       String
  semester     String
  status       ExamStatus   @default(DRAFT)
  visibleFrom  DateTime?
  visibleTo    DateTime?

  studentId    Int?
  student      Student?     @relation(fields: [studentId], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, program, branch, semester, date])
  @@index([studentId, date])
  @@map("Exams")
}

enum ExamType {
  TEST_I
  TEST_II
  END_SEM
}

enum ExamMode {
  REGULAR
  BACKLOG
}

enum ExamCategory {
  ODD
  EVEN
}

enum Program {
  BTECH
  MTECH
  DIPLOMA
  MCA
  BCA
  BBA
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

model Staff {
  id           Int      @id @default(autoincrement())
  email        String   @unique @map("email")
  passwordHash String  @map("passwordHash")
  name         String? @map("name")
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @updatedAt @map("updatedAt")

  @@map("Staff")
}
