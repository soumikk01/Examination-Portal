generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id             Int       @id @default(autoincrement())
  collegeId      String    @unique @map("collegeId")
  name           String
  degree         String?
  department     String?
  studentRoll    String?   @unique @map("studentRoll")
  studentReg     String?   @map("studentReg")
  examinationSem String?   @map("examinationSem")
  batch          String?
  sessionId      String?
  lastLogin      DateTime?

  // New fields used for exam visibility and filtering
  program  Program?
  branch   String?
  semester String?

  exams Exam[]

  @@index([program])
  @@index([branch])
  @@index([semester])
  @@map("Students")
}

model Exam {
  id           Int          @id @default(autoincrement())
  examId       String
  subject      String
  date         DateTime?
  time         String?
  room         String?
  examType     ExamType
  examMode     ExamMode
  examCategory ExamCategory
  program      Program
  branch       String
  semester     String
  status       ExamStatus   @default(DRAFT)
  visibleFrom  DateTime?
  visibleTo    DateTime?

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, program, branch, semester, date])
  @@index([studentId, date])
  @@map("Exams")
}

enum ExamType {
  TEST_I
  TEST_II
  END_SEM
  END_SEM_THEORY
}

enum ExamMode {
  REGULAR
  BACKLOG
}

enum ExamCategory {
  ODD
  EVEN
}

enum Program {
  BTECH
  MTECH
  DIPLOMA
  MCA
  BCA
  BBA
  MBA
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum ExamScheduleStatus {
  DRAFT
  PUBLISHED
}

enum ExamScheduleMode {
  REGULAR
  BACKLOG
}

enum ExamScheduleType {
  TEST_I
  TEST_II
  END_SEM_THEORY
  UNKNOWN
}

model ExamSchedule {
  id           Int              @id @default(autoincrement())
  uploadId     String
  scheduleType ExamScheduleType @default(UNKNOWN)
  mode         ExamScheduleMode @default(REGULAR)

  // Parsed meta
  level        String? // UG / PG
  semester     String? // "1", "2", "3" ...
  batch        String? // "2024-2028"
  regulation   String? // "R25"
  academicYear String? // "AY 2025-26"

  // Department / branch
  department     String? // e.g. "Bachelor of Technology in Biomedical Engineering"
  departmentCode String? // e.g. "BME"
  branch         String? // legacy compatibility with older rows

  // Row fields
  paperCode  String?
  subject    String
  examDate   DateTime
  examDay    String?
  examTime   String?
  status     ExamScheduleStatus @default(DRAFT)
  sourceFile String?
  createdAt  DateTime           @default(now())

  @@index([status, departmentCode, semester, examDate, mode, scheduleType])
  @@index([uploadId])
  @@map("ExamSchedules")
}

model Staff {
  id           Int      @id @default(autoincrement())
  email        String   @unique @map("email")
  passwordHash String   @map("passwordHash")
  name         String?  @map("name")
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @updatedAt @map("updatedAt")

  @@map("Staff")
}

// Dropdown options – all data from DB, no hardcoded lists in codebase
model ProgramOption {
  id        Int              @id @default(autoincrement())
  code      String           @unique // e.g. BTECH – must match Program enum / student.exam usage
  name      String // e.g. B.Tech
  branches  BranchOption[]
  semesters SemesterOption[]

  @@map("ProgramOptions")
}

model BranchOption {
  id          Int           @id @default(autoincrement())
  programCode String
  name        String
  program     ProgramOption @relation(fields: [programCode], references: [code], onDelete: Cascade)

  @@unique([programCode, name])
  @@map("BranchOptions")
}

model SemesterOption {
  id          Int           @id @default(autoincrement())
  programCode String
  number      String // "1", "2", …
  program     ProgramOption @relation(fields: [programCode], references: [code], onDelete: Cascade)

  @@unique([programCode, number])
  @@map("SemesterOptions")
}

// Exam dropdown options – stored in Supabase only (value must match Prisma enums)
model AppOption {
  id        Int    @id @default(autoincrement())
  category  String // examType | examMode | examCategory
  value     String // TEST_I, REGULAR, ODD
  label     String // Test I, Regular, ODD
  sortOrder Int    @default(0) @map("sortOrder")

  @@unique([category, value])
  @@index([category])
  @@map("AppOptions")
}

model ExamRoom {
  id       Int    @id @default(autoincrement())
  roomNo   String @unique
  capacity Int    @default(40)
  venue    String @default("Main Building")

  @@map("ExamRooms")
}

model RoomAllotment {
  id          Int      @id @default(autoincrement())
  examGroup   String
  roomNo      String
  deptCounts  Json
  total       Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  allocations SeatAllocation[]

  @@unique([examGroup, roomNo])
  @@index([examGroup])
  @@index([roomNo])
  @@map("RoomAllotments")
}

model SeatAllocation {
  id          Int      @id @default(autoincrement())
  examGroup   String
  roomNo      String
  columnNo    Int
  seatNo      Int
  studentId   Int?
  dept        String
  studentName String?
  rollNo      String?
  isExtra     Boolean  @default(false)
  allotment   RoomAllotment @relation(fields: [examGroup, roomNo], references: [examGroup, roomNo], onDelete: Cascade)

  @@unique([examGroup, roomNo, columnNo, seatNo])
  @@index([examGroup, roomNo])
  @@index([studentId])
  @@index([examGroup])
  @@map("SeatAllocations")
}
