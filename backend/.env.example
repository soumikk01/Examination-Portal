# Backend Configuration
PORT=8787
NODE_ENV=development
JWT_SECRET=your-secret-key
ADMIN_API_KEY=your-admin-key

# Database (Supabase). Copy from Dashboard → Connect → ORMs → Prisma. Replace [YOUR-PASSWORD].
# DATABASE_URL = pooled (port 6543, for app). DIRECT_URL = direct (port 5432, for migrations).
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6379
# Comma-separated origins (e.g. student + admin frontend URLs)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional: for `npm run db:seed` (default admin). In production, set both to a strong email/password.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=your-secure-password
