# Backend Configuration
PORT=8787
NODE_ENV=production
JWT_SECRET=generate_a_strong_random_secret_here
ADMIN_API_KEY=generate_an_admin_key_here

# Database Connection
# Points to the College's PostgreSQL Database. 
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10&pool_timeout=20
DATABASE_URL=postgresql://root:password@localhost:5432/examination_portal?connection_limit=10&pool_timeout=20
# DIRECT_URL is required by Prisma for safe migrations (can be the exact same as DATABASE_URL)
DIRECT_URL=postgresql://root:password@localhost:5432/examination_portal

# Performance/Caching layer
REDIS_URL=redis://localhost:6379

# Security: Comma-separated allowed frontend domains
CORS_ORIGIN=https://admin.yourcollege.edu,https://students.yourcollege.edu



