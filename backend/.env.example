# Backend Configuration
PORT=8787
NODE_ENV=production
JWT_SECRET=generate_a_strong_random_secret_here
ADMIN_API_KEY=generate_an_admin_key_here

# Database Connection (MongoDB)
# Format: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE
# MongoDB Atlas free tier is supported. Requires a Replica Set (Atlas free tier has this).
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/examination-portal

# Performance/Caching layer (optional)
REDIS_URL=redis://localhost:6379

# Security: Comma-separated allowed frontend domains
CORS_ORIGIN=https://admin.yourcollege.edu,https://students.yourcollege.edu

# Seed credentials (used by prisma/seed.js - only needed when running db:seed)
SEED_ADMIN_EMAIL=admin@yourcollege.edu
SEED_ADMIN_PASSWORD=ChangeThisStrongPassword123!
