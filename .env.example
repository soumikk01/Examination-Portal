# Environment Configuration
# Copy this file to .env and fill in your values.
# Backend, student-web, and admin-web all talk to the same API (backend on 8787).

# Backend runs on 8787 (see backend/.env.example for full backend env)
BACKEND_PORT=8787

# Student Web (apps/student-web, port 5173) - uses Vite proxy /api -> backend in dev
# VITE_API_URL=http://localhost:8787/api/v1

# Admin Web (apps/admin-web, port 5174) - uses Vite proxy /api -> backend in dev
# Create apps/admin-web/.env with:
#   VITE_ADMIN_API_KEY=<same as backend ADMIN_API_KEY for student registration>
#   VITE_ADMIN_API_URL=<optional; set in production if API is on another origin, e.g. https://api.example.com/api/v1>
